*.iml
*.iws
*.ipr
out/
.idea_modules/

# Vim / Neovim
*.swp
*.swo
*.swn
*~
.netrwhist
Session.vim
.nvimrc.local

# Emacs
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
*.elc
auto-save-list
tramp
.\#*

# Sublime Text
*.tmlanguage.cache
*.tmPreferences.cache
*.stTheme.cache
*.sublime-workspace
.sublime-clang-format

# Atom
.atom/

# Eclipse
.classpath
.project
.settings/
.loadpath


# ──────────────────────────────────────────────────────────────────────────────
# MONITORING & OBSERVABILITY
# ──────────────────────────────────────────────────────────────────────────────
prometheus-data/
grafana-data/
alertmanager-data/
*.db                   # Prometheus local TSDB


